{
  "name": "nfc-trace-api",
  "version": "0.1.0",
  "private": true,
  "description": "API experimental de rastreabilidade NFC",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/main.js",
    "start:dev": "node --watch -r ts-node/register src/bootstrap/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test && node scripts/check-boundaries.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "ts-node src/platform/database/cli.ts migrate",
    "db:seed": "ts-node src/platform/database/cli.ts seed",
    "events:failed": "ts-node src/platform/messaging/cli.ts list",
    "events:retry": "ts-node src/platform/messaging/cli.ts retry",
    "openapi": "ts-node scripts/openapi.ts",
    "demo": "node scripts/demo.mjs",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
