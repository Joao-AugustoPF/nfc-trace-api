DATABASE_URL=postgresql://nfc_trace:nfc_trace_local@localhost:55432/nfc_trace
TEST_DATABASE_URL=postgresql://nfc_trace:nfc_trace_local@localhost:55432/nfc_trace_test
PORT=3000
HOST=127.0.0.1
APP_PROCESS_ROLE=all
OUTBOX_POLL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=25
AUTH_SESSION_SECONDS=28800
# Bootstrap explícito: preencher SOMENTE no .env local e remover a senha após usar.
AUTH_BOOTSTRAP_LOGIN=
AUTH_BOOTSTRAP_NAME=
AUTH_BOOTSTRAP_PASSWORD=
# SDM opcional. Sem cofre, UID/NDEF continuam disponíveis; SDM retorna 503.
# Gere um arquivo privado com npm run sdm:keys -- generate-master --output .tmp/private/sdm-master.env
# Para Node local, defina SDM_ENV_FILE=.tmp/private/sdm-master.env e omita as duas variáveis inline.
# Em containers, injete as variáveis inline usando o gerenciador de segredos do ambiente.
# Nunca use uma chave de exemplo, envie por Git ou coloque no aplicativo.
SDM_ENV_FILE=
SDM_ACTIVE_MASTER_VERSION=
SDM_MASTER_KEYS_JSON=
