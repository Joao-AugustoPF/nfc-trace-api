  "info": {
    "title": "NFC Trace API",
    "description": "API experimental sem login. Operador e dispositivo são declarados. HTTP 200 em eventos confirma armazenamento; a decisão informa se a movimentação foi autorizada. UID/NDEF não são autenticação criptográfica.",
    "version": "1.0.0",
    "contact": {}
  },
