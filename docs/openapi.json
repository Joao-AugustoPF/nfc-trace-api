            "type": "boolean"
          },
          "motivo": {
            "type": "string"
          },
          "classificacao": {
            "type": "string",
            "enum": [
              "REGULAR",
              "SUSPEITO"
            ]
          },
          "evidencia": {
            "type": "string",
            "enum": [
              "IDENTIFICADA",
              "INVALIDA",
              "NAO_AVALIADA"
            ]
          },
          "alterouEstado": {
            "type": "boolean"
          },
          "estadoAnterior": {
            "type": "string",
            "nullable": true
          },
          "estadoResultante": {
            "type": "string",
            "nullable": true
          },
          "avisos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "autorizada",
          "motivo",
          "classificacao",
          "evidencia",
          "alterouEstado",
          "estadoAnterior",
          "estadoResultante",
          "avisos"
        ]
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
