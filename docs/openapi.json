            "type": "string",
            "example": "TCC-001",
            "maxLength": 64
          },
          "descricao": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "codigo"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "DecisionResponse": {
        "type": "object",
        "properties": {
