            "type": "string",
            "enum": [
              "REGISTRADA",
              "ATIVA",
              "DESPROVISIONADA"
            ]
          },
          "referenciaNdef": {
            "type": "string",
            "nullable": true
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "ativadoEm": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "encerradoEm": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "etiquetaId",
          "uid",
          "modelo",
          "pedidoId",
          "estrategia",
          "epoca",
          "status",
          "referenciaNdef",
          "criadoEm",
          "ativadoEm",
          "encerradoEm"
        ]
      },
      "ProvisionTagDto": {
        "type": "object",
        "properties": {
          "pedidoId": {
            "type": "string",
            "format": "uuid"
          },
          "uid": {
            "type": "string",
            "example": "04AABBCCDDEE01"
          },
          "modelo": {
            "type": "string",
            "example": "NTAG424DNA"
          },
          "estrategia": {
            "type": "string",
            "enum": [
              "UID",
              "NDEF_ESTATICO"
            ],
            "description": "DINAMICA resulta em 422 nesta versão."
          }
        },
        "required": [
          "pedidoId",
          "uid",
          "modelo",
          "estrategia"
        ]
      },
      "ActivationDto": {
        "type": "object",
        "properties": {
          "bloqueioConfirmado": {
            "type": "boolean",
            "example": true,
            "description": "Declaração do cliente; não constitui prova criptográfica."
          },
          "referenciaNdef": {
            "type": "string",
            "example": "urn:nfc-trace:provisioning:00000000-0000-4000-8000-000000000001"
          }
        },
        "required": [
          "bloqueioConfirmado"
        ]
      },
      "ReadingDto": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "example": "04AABBCCDDEE01"
          },
          "ndef": {
            "type": "string",
            "description": "URI NDEF decodificada; valor exato, sem trim."
          },
          "modelo": {
            "type": "string"
          },
          "tecnologias": {
            "example": [
              "IsoDep",
              "NfcA"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bytesBase64": {
            "type": "string",
            "description": "Bytes opcionais da leitura, codificados em Base64."
          }
        },
        "required": [
          "uid"
        ]
      },
      "ObservationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4 gerado na captura e mantido em retransmissões."
          },
          "versaoContrato": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "provisionamentoId": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "PROVISIONAMENTO",
              "COLETA",
              "RECEBIMENTO",
              "MOVIMENTACAO",
              "EXPEDICAO",
              "ENTREGA"
            ],
            "description": "PROVISIONAMENTO é reservado; tentativas recebem decisão rejeitada."
          },
          "ocorridoEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-24T15:00:00.000Z"
          },
          "dispositivoId": {
            "type": "string",
            "example": "android-lab-01"
          },
          "operadorId": {
            "type": "string",
            "description": "Identidade declarada, sem autenticação na v1."
          },
          "leituraBruta": {
            "$ref": "#/components/schemas/ReadingDto"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "armazenada": {
            "type": "boolean",
            "example": true
          },
          "pedidoId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "estrategia": {
            "type": "string",
            "nullable": true
          },
          "recebidoEm": {
            "type": "string",
            "format": "date-time"
          },
          "decisao": {
            "$ref": "#/components/schemas/DecisionResponse"
          }
        },
        "required": [
          "id",
          "versaoContrato",
          "provisionamentoId",
          "tipo",
          "ocorridoEm",
          "dispositivoId",
          "leituraBruta",
          "armazenada",
          "pedidoId",
          "estrategia",
          "recebidoEm",
          "decisao"
        ]
      },
