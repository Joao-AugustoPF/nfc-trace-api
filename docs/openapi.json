              "COLETADO",
              "RECEBIDO",
              "ENTREGUE"
            ]
          },
          "expedido": {
            "type": "boolean"
          },
          "versao": {
            "type": "number"
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "codigo",
          "descricao",
          "estado",
          "expedido",
          "versao",
          "criadoEm"
        ]
      },
      "ApiErrorResponse": {
